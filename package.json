{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc && vite build",
    "start": "tsx server/index.ts --production",
    "preview": "vite preview",
    "test": "vitest run",
    "export:mariadb": "tsx scripts/export-sqlite-to-mariadb.ts"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.6",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "firebase": "^13.1.0",
    "sweetalert2": "^11.26.25"
  }
}
